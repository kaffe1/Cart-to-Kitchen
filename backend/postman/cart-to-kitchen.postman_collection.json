          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"fresh session with empty cart and stocked inventory\", () => {",
              "  pm.response.to.have.status(200);",
              "  const s = pm.response.json();",
              "  pm.expect(s.id).to.not.eql(Number(pm.collectionVariables.get(\"sessionId\")));",
              "  pm.expect(s.cart).to.be.empty;",
              "  const tomato = s.inventory.find(i => i.ingredientId === \"tomato\");",
              "  pm.expect(tomato.remainingUses).to.be.at.least(6);",
              "  pm.expect(s.wallet.balanceSek).to.eql(Number(pm.collectionVariables.get(\"balanceBefore\")) - 36);",
              "});"
