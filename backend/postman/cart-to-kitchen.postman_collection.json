          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"checkout charges exactly 2 x 18 SEK\", () => {",
              "  pm.response.to.have.status(200);",
              "  const r = pm.response.json();",
              "  pm.expect(r.purchasedUnits).to.eql(2);",
              "  pm.expect(r.spentSek).to.eql(36);",
              "  pm.expect(r.remainingBalanceSek).to.eql(Number(pm.collectionVariables.get(\"balanceBefore\")) - 36);",
