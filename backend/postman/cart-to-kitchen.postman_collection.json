    {
      "name": "Ingredients catalogue (sellable + pantry)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"catalogue carries the full TheMealDB pantry\", () => {",
              "  pm.response.to.have.status(200);",
              "  const items = pm.response.json();",
              "  pm.expect(items.length).to.be.at.least(980);",
              "  const sellable = items.filter(i => !i.isPantry);",
              "  pm.expect(sellable).to.have.lengthOf(80);",
              "  const tomato = items.find(i => i.id === \"tomato\");",
              "  pm.expect(tomato.priceSek).to.eql(18);",
              "  pm.expect(tomato.usesPerUnit).to.eql(3);",
              "  const oil = items.find(i => i.id === \"olive-oil\");",
              "  pm.expect(oil.isPantry).to.eql(true);",
              "  pm.expect(oil.usesPerUnit).to.eql(\"infinite\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/ingredients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ingredients"
          ]
        }
      }
    },
    {
      "name": "Active shopping session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"session snapshot is well formed\", () => {",
              "  pm.response.to.have.status(200);",
              "  const s = pm.response.json();",
              "  pm.expect(s.status).to.eql(\"active\");",
              "  pm.expect(s.wallet.balanceSek).to.be.at.least(500);",
              "  pm.expect(s.wallet.capSek).to.eql(3000);",
              "  pm.expect(s.wallet.hourlyGrantSek).to.eql(100);",
              "});",
              "pm.collectionVariables.set(\"sessionId\", pm.response.json().id);",
              "pm.collectionVariables.set(\"balanceBefore\", pm.response.json().wallet.balanceSek);"
            ]
          }
        }
      ],
